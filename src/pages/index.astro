---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { SITE, activeSocials } from '../config/site.ts';
const socials = activeSocials();
---
<Base bodyClass="brut">
  <!-- ░ brutalist spec-sheet grid on warm paper. visible structure, mono system labels,
       the winged eye as the one interactive graphic, RESERVE as the hero cell. ░ -->
  <div class="sheet">

    <!-- top rail -->
    <header class="rail rail--top">
      <span class="mono tag">Angel0x1</span>
      <span class="mono tag tag--mid">On-device AI journal</span>
      <span class="mono tag tag--end" data-counter>— / {SITE.cap.toLocaleString()} places</span>
    </header>

    <!-- HERO ROW: statement | the watching eye -->
    <section class="row row--hero" data-section>
      <div class="cell cell--say" data-r>
        <p class="mono label">Fig. 01 — the premise</p>
        <h1 class="say">
          It reads your own<br/>words back to you.<br/>
          <span class="say-dim">Nothing ever leaves the phone.</span>
        </h1>
      </div>
      <div class="cell cell--eye" data-r>
        <div class="eye-holder" data-eye><Mark size={300} reactive={true} /></div>
        <p class="mono label label--eye">It watches. It never tells.</p>
      </div>
    </section>

    <!-- RESERVE ROW: the main highlight, a filled cell that owns the page -->
    <section class="row row--reserve" data-section id="reserve">
      <div class="cell cell--reserve" data-r>
        <div class="reserve-head">
          <p class="mono label">Fig. 02 — reserve your place</p>
          <p class="mono places" data-counter>— / {SITE.cap.toLocaleString()} places</p>
        </div>
        <p class="reserve-say confess">The first {SITE.cap.toLocaleString()} get in before anyone else.</p>

        <form class="rz" id="reserve-form" novalidate>
          <input class="vh" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="rz-row">
            <label for="reserve-email" class="vh">Email address</label>
            <input id="reserve-email" name="email" type="email" inputmode="email" placeholder="you@email.com" autocomplete="email" required class="rz-input" />
            <button type="submit" class="rz-btn" id="reserve-submit"><span class="btn-label">Reserve</span></button>
          </div>
          <div class="rz-row rz-coderow" id="reserve-code-row" hidden>
            <label for="reserve-code" class="vh">6-digit code</label>
            <input id="reserve-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="enter 6-digit code" class="rz-input" />
          </div>
          <p class="rz-note mono">A one-time code confirms it&#8217;s really you. Nothing else.</p>
        </form>
        <p class="rz-msg mono" id="reserve-msg" aria-live="polite"></p>
      </div>
    </section>

    <!-- SPEC ROW: three brutalist cells — the plain-spoken guarantees -->
    <section class="row row--spec" data-section>
      <div class="cell cell--spec" data-r>
        <p class="mono label">01 / private</p>
        <p class="spec-say confess">Nothing you write here has ever left this phone.</p>
        <p class="mono spec-meta">AES-256-GCM · sealed on device</p>
      </div>
      <div class="cell cell--spec" data-r>
        <p class="mono label">02 / on-device</p>
        <p class="spec-say confess">It doesn&#8217;t analyze you. It listens.</p>
        <p class="mono spec-meta">the model runs locally, by default</p>
      </div>
      <div class="cell cell--spec" data-r>
        <p class="mono label">03 / yours</p>
        <p class="spec-say confess">A wipe is a burn. The key is gone, not hidden.</p>
        <p class="mono spec-meta">no server · no account · no us</p>
      </div>
    </section>

    <!-- bottom rail -->
    <footer class="rail rail--bottom">
      <nav class="mono links">
        {socials.map((s) => <a href={s.href} target="_blank" rel="me noopener">{s.label}</a>)}
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
      <span class="mono tag tag--end">Angel0x1 · {new Date().getFullYear()}</span>
    </footer>
  </div>

  <script is:inline type="module" src="/scripts/reserve.js"></script>
</Base>

<!-- STYLE_MARK -->
<style>
  :global(body.brut) { background: var(--paper); color: var(--ink); }

  /* the sheet: a bordered architectural document, hairline structure everywhere */
  .sheet {
    max-width: 1240px; margin-inline: auto; min-height: 100svh;
    border-left: 1px solid var(--line); border-right: 1px solid var(--line);
    display: flex; flex-direction: column;
  }
  .row { border-top: 1px solid var(--line); display: grid; }
  .cell { padding: clamp(24px, 3.4vw, 52px); position: relative; }

  .mono { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; }
  .confess { font-family: var(--confess); font-weight: 400; letter-spacing: -0.015em; line-height: 1.16; }
  .label { color: var(--bone-soft); margin-bottom: clamp(18px,2.4vw,30px); }

  /* rails */
  .rail { display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 14px clamp(24px,3.4vw,52px); }
  .rail--top { border-bottom: 0; }
  .rail--bottom { border-top: 1px solid var(--line); margin-top: auto; }
  .tag { color: var(--bone-soft); }
  .tag--mid { color: var(--ink); }
  .tag--end { color: var(--ember); }
  @media (max-width: 640px) { .tag--mid { display: none; } }

  /* held-breath reveals */
  :global(html.js) [data-r] { opacity: 0; transform: translateY(14px); }
  :global(html.js) [data-r].is-in { opacity: 1; transform: none;
    transition: opacity 1.1s var(--ease-cine), transform 1.2s var(--ease-cine); }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-r] { opacity: 1 !important; transform: none !important; }
  }

  /* links */
  .links { display: flex; gap: 18px; }
  .links a { color: var(--bone-soft); }
  .links a:hover { color: var(--ink); }

  /* ── HERO ROW ─────────────────────────────────────────────────────────────── */
  .row--hero { grid-template-columns: 1.15fr 1fr; }
  .cell--say { display: flex; flex-direction: column; justify-content: center; }
  .cell--eye { border-left: 1px solid var(--line); display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 22px; background: var(--panel); }
  .say { font-family: var(--confess); font-weight: 300; font-size: clamp(30px,4.6vw,60px);
    line-height: 1.1; letter-spacing: -0.025em; color: var(--ink); }
  .say-dim { color: var(--bone-soft); font-style: italic; }
  .eye-holder { will-change: transform; filter: drop-shadow(0 18px 34px rgba(23,21,15,0.16)); }
  .label--eye { margin: 0; color: var(--bone-soft); text-align: center; }
  @media (max-width: 780px) {
    .row--hero { grid-template-columns: 1fr; }
    .cell--eye { border-left: 0; border-top: 1px solid var(--line); order: -1; }
  }

  /* ── RESERVE ROW — the highlight ─────────────────────────────────────────── */
  .row--reserve { grid-template-columns: 1fr; }
  .cell--reserve { background: var(--paper-2); padding-block: clamp(40px,6vw,84px); }
  .reserve-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .reserve-head .places { color: var(--ember); }
  .reserve-say { font-size: clamp(26px,3.4vw,46px); color: var(--ink); margin: clamp(14px,2vw,22px) 0 clamp(26px,3vw,38px); max-width: 20ch; }
  .rz { max-width: 620px; display: flex; flex-direction: column; gap: 10px; }
  .rz-row { display: flex; gap: 0; }
  #reserve-code-row[hidden] { display: none; }
  .rz-coderow { margin-top: 10px; }
  /* brutalist inputs: hard edges, heavy hairline, no radius */
  .rz-input { flex: 1; min-width: 0; font-family: var(--mono); font-size: 15px; letter-spacing: 0.02em;
    color: var(--ink); background: var(--paper); border: 1px solid var(--ink); border-radius: 0;
    padding: 18px 20px; transition: background .2s var(--ease); }
  .rz-input::placeholder { color: var(--paper-dim); text-transform: none; letter-spacing: 0.04em; }
  .rz-input:focus { outline: none; background: var(--panel); box-shadow: inset 0 0 0 1px var(--ink); }
  .rz-coderow .rz-input { border: 1px solid var(--ink); }
  #reserve-code { letter-spacing: 0.4em; text-align: center; }
  .rz-btn { flex-shrink: 0; font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--paper); background: var(--ink); border: 1px solid var(--ink); border-radius: 0;
    padding: 0 clamp(28px,4vw,48px); min-height: 56px; cursor: pointer; margin-left: -1px;
    transition: background .3s var(--ease), color .3s var(--ease); }
  .rz-btn:hover { background: var(--ember); border-color: var(--ember); }
  .rz-note { margin-top: 6px; color: var(--bone-soft); text-transform: none; letter-spacing: 0.04em; font-size: 11px; }
  .rz-msg { min-height: 18px; margin-top: 14px; text-transform: none; letter-spacing: 0.04em; font-size: 12px; color: var(--ink-soft); }
  .rz-msg.ok { color: var(--ember); } .rz-msg.err { color: #B3492E; }
  @media (max-width: 560px) {
    .rz-row { flex-direction: column; gap: 10px; }
    .rz-btn { margin-left: 0; min-height: 54px; padding: 16px; }
  }

  /* ── SPEC ROW — three brutalist guarantee cells ──────────────────────────── */
  .row--spec { grid-template-columns: repeat(3, 1fr); }
  .cell--spec { display: flex; flex-direction: column; min-height: clamp(200px,24vw,280px); }
  .cell--spec + .cell--spec { border-left: 1px solid var(--line); }
  .spec-say { font-size: clamp(19px,1.8vw,26px); color: var(--ink); margin-bottom: auto; max-width: 22ch; }
  .spec-meta { color: var(--bone-soft); text-transform: none; letter-spacing: 0.04em; font-size: 11px; margin-top: 28px; }
  @media (max-width: 780px) {
    .row--spec { grid-template-columns: 1fr; }
    .cell--spec + .cell--spec { border-left: 0; border-top: 1px solid var(--line); }
    .cell--spec { min-height: 0; }
    .spec-say { margin-bottom: 20px; }
  }
</style>
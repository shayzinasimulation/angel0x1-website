---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SITE, activeSocials } from '../config/site.ts';
const socials = activeSocials();
---
<Base bodyClass="home">
  <main class="stage" data-load>
    <!-- TOP ROW -->
    <header class="hd">
      <a href="/" class="wordmark swap" aria-label="Angel0x1 — home" data-cursor>
        <span>ANGEL0X1</span><span aria-hidden="true">ANGEL0X1</span>
      </a>
      <div class="hd-right">
        <span class="meta hd-tag">On-device AI</span>
        {socials.map((s) => (
          <a href={s.href} class="ic" target="_blank" rel="me noopener" aria-label={s.label} data-cursor>
            <SocialIcon name={s.key} size={19} />
          </a>
        ))}
      </div>
    </header>

    <!-- CORE -->
    <section class="core">
      <div class="eye" data-eye aria-hidden="true"><Mark size={210} /></div>
      <h1 class="display" data-r="1">The journal<br/>that knows you.</h1>
      <p class="lede" data-r="2">Write. It listens, and reflects you back — on your device, never anywhere else.</p>

      <form class="rz" id="reserve-form" data-r="3" novalidate>
        <input class="vh" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="rz-row">
          <label for="reserve-email" class="vh">Email address</label>
          <input id="reserve-email" name="email" type="email" inputmode="email" placeholder="you@email.com" autocomplete="email" required class="rz-input" data-cursor />
          <button type="submit" class="rz-btn" id="reserve-submit" data-cursor>
            <span class="btn-label">Reserve</span>
          </button>
        </div>
        <div class="rz-row rz-coderow" id="reserve-code-row" hidden>
          <label for="reserve-code" class="vh">6-digit code</label>
          <input id="reserve-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="6-digit code" class="rz-input" data-cursor />
        </div>
        <p class="rz-note">Email only. A one-time code confirms it's really you.</p>
      </form>
      <p class="rz-msg" id="reserve-msg" aria-live="polite"></p>
    </section>

    <!-- BOTTOM ROW -->
    <footer class="ft">
      <span class="meta ft-tag">Private journal · never tells</span>
      <span class="count" data-counter data-r="4">— / {SITE.cap.toLocaleString()}</span>
      <nav class="ft-links">
        <a href="/privacy" class="meta swap" data-cursor><span>Privacy</span><span aria-hidden="true">Privacy</span></a>
        <a href="/terms" class="meta swap" data-cursor><span>Terms</span><span aria-hidden="true">Terms</span></a>
      </nav>
    </footer>
  </main>

  <script is:inline type="module" src="/scripts/reserve.js"></script>
</Base>

<!-- STYLE_MARK -->
<style>
  /* Single-screen: lock scroll on capable viewports; relax on short/small screens
     so the reserve form (and mobile keyboard) never get trapped. */
  :global(body.home) { overflow-x: hidden; }
  @media (min-width: 720px) and (min-height: 720px) {
    :global(html:has(body.home)), :global(body.home) { height: 100svh; overflow: hidden; }
  }

  .stage {
    position: relative; box-sizing: border-box;
    min-height: 100svh; width: 100%;
    display: grid; grid-template-rows: auto 1fr auto;
    padding: clamp(20px, 3.4vh, 40px) clamp(20px, 4vw, 54px);
    gap: clamp(12px, 2vh, 26px);
  }
  /* editorial hairline frame (k95) */
  .stage::before {
    content: ""; position: absolute; inset: clamp(12px, 1.6vw, 22px);
    border: 1px solid var(--line); border-radius: 18px; pointer-events: none;
  }
  /* soft red-iris glow, upper area — the one atmospheric accent */
  .stage::after {
    content: ""; position: absolute; z-index: -1;
    width: min(80vw, 720px); aspect-ratio: 1; top: 8%; left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(179,58,43,0.10) 0%, rgba(179,58,43,0.03) 40%, transparent 66%);
    pointer-events: none;
  }

  /* custom cursor dot (shown only when JS adds .has-cursor) */
  :global(.cursor) { display: none; }
  :global(html.has-cursor) .stage,
  :global(html.has-cursor) { cursor: none; }
  :global(html.has-cursor .cursor) {
    display: block; position: fixed; top: 0; left: 0; z-index: 300;
    width: 12px; height: 12px; border-radius: 50%; background: var(--ink);
    mix-blend-mode: difference; pointer-events: none;
    transition: width .25s var(--ease), height .25s var(--ease);
  }
  :global(html.has-cursor .cursor.is-lg) { width: 42px; height: 42px; background: var(--red); }

  /* TOP ROW */
  .hd { display: flex; align-items: center; justify-content: space-between; }
  .wordmark { font-family: var(--mono); font-weight: 700; font-size: 15px; letter-spacing: 0.2em; color: var(--ink); }
  .hd-right { display: flex; align-items: center; gap: 18px; }
  .hd-tag { color: var(--faint); }
  .ic { display: inline-flex; align-items: center; justify-content: center; color: var(--faint);
    width: 34px; height: 34px; transition: color .25s var(--ease), transform .25s var(--ease); }
  .ic:hover { color: var(--red); transform: translateY(-2px); }

  /* CORE */
  .core { align-self: center; display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: clamp(14px, 2.2vh, 26px); }
  .eye { will-change: transform; filter: drop-shadow(0 22px 40px rgba(26,23,20,0.14)); }
  .core .display { font-size: clamp(40px, 7vw, 96px); color: var(--ink); }
  .core .lede { max-width: 44ch; margin-inline: auto; }

  /* RESERVE */
  .rz { width: 100%; max-width: 500px; margin-top: 6px; display: flex; flex-direction: column; gap: 10px; }
  .rz-row { display: flex; gap: 8px; }
  #reserve-code-row[hidden] { display: none; }
  .rz-input {
    flex: 1; min-width: 0; font-family: var(--sans); font-size: 16px; color: var(--ink);
    background: var(--panel); border: 1px solid var(--line); border-radius: 13px;
    padding: 15px 18px; transition: border-color .25s, box-shadow .25s;
  }
  .rz-input::placeholder { color: var(--faint); }
  .rz-input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgba(26,23,20,0.05); }
  #reserve-code { letter-spacing: 0.34em; text-align: center; font-variant-numeric: tabular-nums; }
  .rz-btn {
    flex-shrink: 0; font-family: var(--mono); font-weight: 700; font-size: 13px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--paper); background: var(--ink); border: 1px solid var(--ink);
    border-radius: 13px; padding: 0 26px; min-height: 52px; cursor: pointer;
    transition: background .3s var(--ease), transform .3s var(--ease);
  }
  .rz-btn:hover { background: var(--red); border-color: var(--red); }
  .rz-note { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; color: var(--faint); }
  .rz-msg { min-height: 18px; margin-top: 12px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; }
  .rz-msg.ok { color: var(--red); } .rz-msg.err { color: #c0392b; }

  /* BOTTOM ROW — mono "instrument" meta, k95 framing */
  .ft { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ft .meta, .count { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; }
  .ft-tag { color: var(--faint); }
  .count { color: var(--red); font-variant-numeric: tabular-nums; text-align: center; }
  .ft-links { display: flex; gap: 16px; }
  .ft-links .meta { color: var(--faint); }
  .ft-links .meta:hover { color: var(--ink); }

  /* letter-swap hover (pointer + motion-safe): two stacked copies roll up */
  .swap { position: relative; overflow: hidden; display: inline-flex; }
  .swap > span { display: inline-block; transition: transform .34s var(--ease-cine); }
  .swap > span:nth-child(2) { position: absolute; inset: 0; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .swap:hover > span:nth-child(1) { transform: translateY(-115%); }
    .swap:hover > span:nth-child(2) { transform: translateY(-100%); }
  }

  /* orchestrated load reveal: eye settles, then lines rise in sequence.
     Hidden state is gated on html.js so a JS failure still shows everything. */
  :global(html.js) .eye { opacity: 0; transform: translateY(10px) scale(0.96); }
  :global(html.js) [data-r] { opacity: 0; transform: translateY(18px); }
  .stage.is-in .eye { opacity: 1; transform: none; transition: opacity 1s var(--ease-cine), transform 1.2s var(--ease-cine); }
  .stage.is-in [data-r] { opacity: 1; transform: none; transition: opacity .9s var(--ease-cine), transform 1s var(--ease-cine); }
  .stage.is-in [data-r="1"] { transition-delay: .12s; }
  .stage.is-in [data-r="2"] { transition-delay: .22s; }
  .stage.is-in [data-r="3"] { transition-delay: .32s; }
  .stage.is-in [data-r="4"] { transition-delay: .42s; }

  /* MOBILE */
  @media (max-width: 620px) {
    .stage { gap: 18px; padding: 22px 18px; }
    .hd-tag { display: none; }
    .core { gap: 16px; }
    .core .display { font-size: clamp(34px, 12vw, 56px); }
    .rz-row { flex-direction: column; }
    .rz-btn { min-height: 54px; padding: 15px; }
    .ft { flex-direction: column; gap: 8px; text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eye, [data-r] { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { SITE, activeSocials } from '../config/site.ts';
const socials = activeSocials();
---
<Base bodyClass="brut">
  <div class="sheet">

    <!-- top rail -->
    <header class="rail rail--top">
      <span class="mono tag">Angel0x1</span>
      <span class="mono tag tag--end" data-counter>— / {SITE.cap.toLocaleString()}</span>
    </header>

    <!-- ░ HERO — reserve, dead-centre on open (esp. mobile) ░ -->
    <section class="hero" data-section id="reserve">
      <div class="hero-in" data-r>
        <a href="/" class="hero-eye" data-eye aria-label="Angel0x1"><Mark size={104} reactive={true} /></a>
        <p class="mono label hero-eyebrow">The journal that reads you forward</p>
        <h1 class="hero-say">It studies what you&#8217;ve written<br/>and tells you where you&#8217;re going.</h1>

        <form class="rz" id="reserve-form" novalidate>
          <input class="vh" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="rz-row">
            <label for="reserve-email" class="vh">Email address</label>
            <input id="reserve-email" name="email" type="email" inputmode="email" placeholder="you@email.com" autocomplete="email" required class="rz-input" />
            <button type="submit" class="rz-btn" id="reserve-submit"><span class="btn-label">Reserve your spot</span></button>
          </div>
          <div class="rz-row rz-coderow" id="reserve-code-row" hidden>
            <label for="reserve-code" class="vh">6-digit code</label>
            <input id="reserve-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="enter 6-digit code" class="rz-input" />
          </div>
        </form>
        <p class="rz-msg mono" id="reserve-msg" aria-live="polite"></p>
        <p class="hero-offer mono">The first {SITE.cap.toLocaleString()} reserve free — <span>3 months of Angel0x1, on the house.</span></p>
        <p class="hero-remain mono" data-counter>— / {SITE.cap.toLocaleString()} places left</p>
      </div>
      <span class="hero-scroll mono" aria-hidden="true">Scroll ↓</span>
    </section>

    <!-- ░ THE SIGNATURE FEATURE — the trajectory graph ░ -->
    <section class="row row--graph" data-section>
      <div class="cell cell--graph" data-r>
        <div class="graph-head">
          <p class="mono label">Fig. 01 — where you&#8217;re heading</p>
          <p class="graph-say confess">Every entry is a point. The line is the arc you&#8217;re on.<br/>The dotted path is where it&#8217;s taking you.</p>
        </div>

        <div class="graph" data-r aria-hidden="true">
          <svg viewBox="0 0 820 340" class="graph-svg" role="img" aria-label="A trajectory read from past journal entries, projecting forward">
            <!-- baseline -->
            <line class="g-axis" x1="30" y1="300" x2="800" y2="300" />
            <!-- past trajectory through the entries -->
            <polyline class="g-line" pathLength="1" points="70,250 150,240 230,262 310,214 390,236 470,192 548,206" />
            <!-- NOW divider — the line between past and future -->
            <line class="g-now" x1="590" y1="70" x2="590" y2="300" />
            <text class="g-nowlab mono-svg" x="590" y="322" text-anchor="middle">now</text>
            <!-- projection — where you're heading -->
            <path class="g-proj" pathLength="1" d="M548,206 C 620,180 680,150 770,96" fill="none" />
            <circle class="g-proj-dot" cx="770" cy="96" r="6.5" />
            <!-- entry dots -->
            <circle class="g-dot" cx="70" cy="250" r="5"/>
            <circle class="g-dot" cx="150" cy="240" r="5"/>
            <circle class="g-dot" cx="230" cy="262" r="5"/>
            <circle class="g-dot" cx="310" cy="214" r="5"/>
            <circle class="g-dot" cx="390" cy="236" r="5"/>
            <circle class="g-dot" cx="470" cy="192" r="5"/>
            <circle class="g-dot" cx="548" cy="206" r="5"/>
            <!-- recurring-word reads, surfaced from the entries -->
            <text class="g-word mono-svg" x="230" y="288">&#8220;moving&#8221;</text>
            <text class="g-word mono-svg" x="470" y="172">&#8220;fine.&#8221; ×7</text>
            <text class="g-head mono-svg" x="772" y="70" text-anchor="end">a change you keep circling ↗</text>
            <text class="g-axlab mono-svg" x="30" y="322">your entries →</text>
          </svg>
        </div>
      </div>
    </section>

    <!-- ░ WHAT MAKES IT DIFFERENT — each cell demonstrates itself ░ -->
    <section class="row row--diff" data-section>
      <div class="cell cell--diff" data-r>
        <p class="mono label">01 / it predicts</p>
        <div class="demo demo--predict" aria-hidden="true">
          <svg viewBox="0 0 220 90" class="demo-svg">
            <polyline class="d-line" pathLength="1" points="14,64 44,58 74,66 104,48 132,54"/>
            <circle class="d-dot" cx="14" cy="64" r="3.5"/><circle class="d-dot" cx="44" cy="58" r="3.5"/>
            <circle class="d-dot" cx="74" cy="66" r="3.5"/><circle class="d-dot" cx="104" cy="48" r="3.5"/>
            <circle class="d-dot" cx="132" cy="54" r="3.5"/>
            <path class="d-proj" pathLength="1" d="M132,54 C 168,44 186,32 206,20" fill="none"/>
            <circle class="d-projdot" cx="206" cy="20" r="4"/>
          </svg>
        </div>
        <p class="diff-say confess">Reads your own entries and names the pattern before you do.</p>
        <p class="mono diff-meta">on-device RAG over your journal — not a chatbot guessing</p>
      </div>

      <div class="cell cell--diff" data-r>
        <p class="mono label">02 / it finds meaning</p>
        <div class="demo demo--words" aria-hidden="true">
          <span class="d-ln"></span><span class="d-ln"></span><span class="d-ln"></span>
          <span class="d-ln"></span><span class="d-ln"></span>
          <span class="d-tally mono">&#8220;fine.&#8221; <b>&times;7</b></span>
        </div>
        <p class="diff-say confess">The word you keep returning to, counted and read back.</p>
        <p class="mono diff-meta">recurring themes · reflections · the arc across months</p>
      </div>

      <div class="cell cell--diff" data-r>
        <p class="mono label">03 / a hub of minds</p>
        <div class="demo demo--hub" aria-hidden="true">
          <span class="d-chip mono">Gemma</span>
          <span class="d-chip mono">Qwen</span>
          <span class="d-chip mono">Phi</span>
        </div>
        <p class="diff-say confess">Choose the model that reads you. Several, all on-device.</p>
        <p class="mono diff-meta">local model hub — swap the mind, nothing leaves the phone</p>
      </div>

      <div class="cell cell--diff" data-r>
        <p class="mono label">04 / just talk</p>
        <div class="demo demo--voice" aria-hidden="true">
          <span class="d-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          <span class="d-caption mono">writing it down…</span>
        </div>
        <p class="diff-say confess">Speak the entry. It listens and writes it down.</p>
        <p class="mono diff-meta">on-device voice input · transcribed locally</p>
      </div>
    </section>

    <!-- bottom rail -->
    <footer class="rail rail--bottom">
      <span class="mono tag privacy-line">All of it on your phone. None of it anywhere else.</span>
      <nav class="mono links">
        {socials.map((s) => <a href={s.href} target="_blank" rel="me noopener">{s.label}</a>)}
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
    </footer>
  </div>

  <script is:inline type="module" src="/scripts/reserve.js"></script>
</Base>

<!-- STYLE_MARK -->
<style>
  :global(body.brut) { background: var(--paper); color: var(--ink); }
  .sheet { max-width: 1240px; margin-inline: auto; min-height: 100svh;
    border-left: 1px solid var(--line); border-right: 1px solid var(--line);
    display: flex; flex-direction: column; }
  .row { border-top: 1px solid var(--line); display: grid; }
  .cell { padding: clamp(24px, 3.4vw, 52px); position: relative; }
  .mono { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; }
  .confess { font-family: var(--confess); font-weight: 400; letter-spacing: -0.015em; line-height: 1.18; }
  .label { color: var(--bone-soft); margin-bottom: clamp(16px,2.2vw,26px); }

  .rail { display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 13px clamp(20px,3.4vw,52px); }
  .rail--bottom { border-top: 1px solid var(--line); margin-top: auto; flex-wrap: wrap; }
  .tag { color: var(--bone-soft); }
  .tag--end { color: var(--ember); }
  .privacy-line { color: var(--ink); text-transform: none; letter-spacing: 0.02em; font-family: var(--confess); font-size: 15px; }
  .links { display: flex; gap: 18px; }
  .links a { color: var(--bone-soft); } .links a:hover { color: var(--ink); }

  :global(html.js) [data-r] { opacity: 0; transform: translateY(14px); }
  :global(html.js) [data-r].is-in { opacity: 1; transform: none;
    transition: opacity 1.1s var(--ease-cine), transform 1.2s var(--ease-cine); }
  @media (prefers-reduced-motion: reduce) { :global(html.js) [data-r] { opacity: 1 !important; transform: none !important; } }

  /* ── HERO — reserve dead-centre on open ─────────────────────────────────── */
  .hero { border-top: 1px solid var(--line); min-height: calc(100svh - 50px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: clamp(40px,8vh,90px) var(--gutter); position: relative; }
  .hero-in { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 620px; }
  .hero-eye { display: block; margin-bottom: 26px; filter: drop-shadow(0 14px 26px rgba(23,21,15,0.16)); }
  .hero-eyebrow { color: var(--bone-soft); }
  .hero-say { font-family: var(--confess); font-weight: 300; font-size: clamp(26px,3.6vw,46px);
    line-height: 1.12; letter-spacing: -0.025em; color: var(--ink); margin: 12px 0 clamp(28px,4vh,40px); }
  .rz { width: 100%; max-width: 500px; display: flex; flex-direction: column; gap: 10px; }
  .rz-row { display: flex; gap: 0; }
  #reserve-code-row[hidden] { display: none; }
  .rz-coderow { margin-top: 10px; }
  .rz-input { flex: 1; min-width: 0; font-family: var(--mono); font-size: 15px; letter-spacing: 0.02em;
    color: var(--ink); background: var(--panel); border: 1px solid var(--ink); border-radius: 0;
    padding: 17px 18px; text-align: left; }
  .rz-input::placeholder { color: var(--paper-dim); text-transform: none; letter-spacing: 0.04em; }
  .rz-input:focus { outline: none; box-shadow: inset 0 0 0 1px var(--ink); }
  #reserve-code { letter-spacing: 0.4em; text-align: center; }
  .rz-btn { flex-shrink: 0; font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--paper); background: var(--ink); border: 1px solid var(--ink); border-radius: 0;
    padding: 0 clamp(22px,3vw,34px); min-height: 56px; cursor: pointer; margin-left: -1px;
    transition: background .3s var(--ease); }
  .rz-btn:hover { background: var(--ember); border-color: var(--ember); }
  .rz-msg { min-height: 16px; margin-top: 12px; text-transform: none; letter-spacing: 0.04em; font-size: 12px; color: var(--ink-soft); }
  .rz-msg.ok { color: var(--ember); } .rz-msg.err { color: #B3492E; }
  .hero-offer { margin-top: clamp(22px,3vh,30px); color: var(--ink); text-transform: none; letter-spacing: 0.03em; font-size: 12px; }
  .hero-offer span { color: var(--ember); }
  .hero-remain { margin-top: 8px; color: var(--bone-soft); }
  .hero-scroll { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); color: var(--paper-dim); }
  @media (prefers-reduced-motion: no-preference) { .hero-scroll { animation: bob 2.6s var(--ease) infinite; } }
  @keyframes bob { 0%,100%{opacity:.45;transform:translate(-50%,0)} 50%{opacity:.9;transform:translate(-50%,4px)} }
  @media (max-width: 560px) {
    .rz-row { flex-direction: column; gap: 10px; }
    .rz-btn { margin-left: 0; min-height: 56px; padding: 17px; }
    .hero-scroll { display: none; }
  }

  /* ── SIGNATURE GRAPH — entries → projected trajectory ───────────────────── */
  .cell--graph { padding-block: clamp(40px,6vw,80px); }
  .graph-head { max-width: 640px; }
  .graph-say { font-size: clamp(20px,2.4vw,32px); color: var(--ink); margin-top: 14px; }
  .graph { margin-top: clamp(30px,5vw,54px); }
  .graph-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .g-axis { stroke: var(--line); stroke-width: 1; }
  .g-now  { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 5; }
  .mono-svg { font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.14em; }
  .g-nowlab { font-size: 12px; fill: var(--bone-soft); }
  .g-axlab, .g-word { font-size: 12px; fill: var(--bone-soft); }
  .g-head { font-size: 13px; fill: var(--ember); letter-spacing: 0.06em; }
  .g-line { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .g-proj { stroke: var(--ember); stroke-width: 2.5; stroke-dasharray: 1 8; stroke-linecap: round; }
  .g-dot  { fill: var(--paper); stroke: var(--ink); stroke-width: 2; }
  .g-proj-dot { fill: var(--ember); }

  /* draw states — gated on html.js so no-JS shows the finished graph */
  :global(html.js) .g-line { stroke-dashoffset: 1; }
  :global(html.js) .g-future { clip-path: inset(0 100% 0 0); }
  :global(html.js) .g-dot, :global(html.js) .g-word, :global(html.js) .g-head, :global(html.js) .g-nowlab, :global(html.js) .g-now { opacity: 0; }
  .graph.is-in .g-line { animation: gdraw 1.5s var(--ease-cine) .25s forwards; }
  .graph.is-in .g-now, .graph.is-in .g-nowlab { animation: gfade .7s var(--ease) 1.35s forwards; }
  .graph.is-in .g-future { animation: gwipe 1.15s var(--ease-cine) 1.5s forwards; }
  .graph.is-in .g-word { animation: gfade .7s var(--ease) 1.0s forwards; }
  .graph.is-in .g-head { animation: gfade .8s var(--ease) 2.3s forwards; }
  .graph.is-in .g-dot:nth-of-type(1){animation:gpop .5s var(--ease) .5s forwards}
  .graph.is-in .g-dot:nth-of-type(2){animation:gpop .5s var(--ease) .62s forwards}
  .graph.is-in .g-dot:nth-of-type(3){animation:gpop .5s var(--ease) .74s forwards}
  .graph.is-in .g-dot:nth-of-type(4){animation:gpop .5s var(--ease) .86s forwards}
  .graph.is-in .g-dot:nth-of-type(5){animation:gpop .5s var(--ease) .98s forwards}
  .graph.is-in .g-dot:nth-of-type(6){animation:gpop .5s var(--ease) 1.1s forwards}
  .graph.is-in .g-dot:nth-of-type(7){animation:gpop .5s var(--ease) 1.22s forwards}
  @media (prefers-reduced-motion: no-preference) {
    .graph.is-in .g-proj-dot { animation: gpulse 2.4s var(--ease) 2.6s infinite; transform-box: fill-box; transform-origin: center; }
  }
  @keyframes gdraw { to { stroke-dashoffset: 0; } }
  @keyframes gwipe { to { clip-path: inset(0 -6% 0 0); } }
  @keyframes gfade { to { opacity: 1; } }
  @keyframes gpop  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes gpulse { 0%,100%{opacity:1} 50%{opacity:.4} }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .g-line { stroke-dashoffset: 0; }
    :global(html.js) .g-future { clip-path: none; }
    :global(html.js) .g-dot, :global(html.js) .g-word, :global(html.js) .g-head, :global(html.js) .g-nowlab, :global(html.js) .g-now { opacity: 1; }
  }

  /* ── DIFFERENTIATORS — 4 cells, each demonstrates itself ─────────────────── */
  .row--diff { grid-template-columns: 1fr 1fr; }
  .cell--diff { display: flex; flex-direction: column; padding-block: clamp(30px,3.4vw,46px); }
  .cell--diff:nth-child(even) { border-left: 1px solid var(--line); }
  .cell--diff:nth-child(n+3) { border-top: 1px solid var(--line); }
  .diff-say { font-size: clamp(18px,1.6vw,23px); color: var(--ink); margin-bottom: 14px; max-width: 26ch; }
  .diff-meta { color: var(--bone-soft); text-transform: none; letter-spacing: 0.03em; font-size: 10.5px; margin-top: auto; line-height: 1.5; }

  .demo { height: 92px; margin-bottom: clamp(20px,2.4vw,30px); display: flex; align-items: center; }
  .demo-svg { width: 100%; max-width: 240px; height: 90px; overflow: visible; }

  /* 01 predict — mini trajectory draws, projection wipes to a pulsing dot */
  .d-line { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .d-proj { stroke: var(--ember); stroke-width: 2; stroke-dasharray: 1 6; stroke-linecap: round; }
  .d-dot { fill: var(--paper); stroke: var(--ink); stroke-width: 1.6; }
  .d-projdot { fill: var(--ember); }
  :global(html.js) .d-line { stroke-dashoffset: 1; }
  :global(html.js) .d-proj { opacity: 0; }
  :global(html.js) .d-projdot { opacity: 0; }
  .cell--diff.is-in .d-line { animation: gdraw 1.1s var(--ease-cine) .2s forwards; }
  .cell--diff.is-in .d-proj { animation: gfade .8s var(--ease) 1.1s forwards; }
  .cell--diff.is-in .d-projdot { animation: gfade .5s var(--ease) 1.7s forwards; }
  @media (prefers-reduced-motion: no-preference) { .cell--diff.is-in .d-projdot { animation: gfade .5s var(--ease) 1.7s forwards, gpulse 2.4s var(--ease) 2.2s infinite; transform-box: fill-box; transform-origin: center; } }

  /* 02 finds meaning — faint entry lines stack, the recurring word tallies to x7 */
  .demo--words { flex-direction: column; align-items: flex-start; gap: 7px; justify-content: center; }
  .demo--words .d-ln { display: block; height: 2px; background: var(--line); border-radius: 2px; opacity: 0; }
  .demo--words .d-ln:nth-child(1){ width: 78%; } .demo--words .d-ln:nth-child(2){ width: 54%; }
  .demo--words .d-ln:nth-child(3){ width: 70%; } .demo--words .d-ln:nth-child(4){ width: 44%; }
  .demo--words .d-ln:nth-child(5){ width: 62%; }
  .cell--diff.is-in .demo--words .d-ln { animation: gfade .5s var(--ease) forwards; }
  .cell--diff.is-in .demo--words .d-ln:nth-child(2){ animation-delay:.12s } .cell--diff.is-in .demo--words .d-ln:nth-child(3){ animation-delay:.24s }
  .cell--diff.is-in .demo--words .d-ln:nth-child(4){ animation-delay:.36s } .cell--diff.is-in .demo--words .d-ln:nth-child(5){ animation-delay:.48s }
  .d-tally { margin-top: 6px; color: var(--bone-soft); text-transform: none; letter-spacing: 0.06em; font-size: 13px; opacity: 0; }
  .d-tally b { color: var(--ember); }
  .cell--diff.is-in .d-tally { animation: gfade .6s var(--ease) .7s forwards; }

  /* 03 model hub — selection cycles between three on-device models */
  .demo--hub { gap: 8px; flex-wrap: wrap; }
  .d-chip { border: 1px solid var(--line); color: var(--ink-soft); padding: 8px 14px; font-size: 11px;
    transition: border-color .4s var(--ease), color .4s var(--ease), background .4s var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    .cell--diff.is-in .d-chip:nth-child(1){ animation: pick 4.5s var(--ease) infinite; }
    .cell--diff.is-in .d-chip:nth-child(2){ animation: pick 4.5s var(--ease) 1.5s infinite; }
    .cell--diff.is-in .d-chip:nth-child(3){ animation: pick 4.5s var(--ease) 3s infinite; }
  }
  @keyframes pick { 0%,22%,100%{ border-color:var(--line); color:var(--ink-soft); background:transparent; } 8%,16%{ border-color:var(--ink); color:var(--paper); background:var(--ink); } }

  /* 04 voice — waveform listens, caption confirms it's written */
  .demo--voice { gap: 14px; }
  .d-bars { display: inline-flex; align-items: center; gap: 4px; height: 40px; }
  .d-bars i { width: 3px; height: 30%; background: var(--ember); border-radius: 2px; }
  @media (prefers-reduced-motion: no-preference) {
    .cell--diff.is-in .d-bars i { animation: wave 1.1s var(--ease) infinite; }
    .cell--diff.is-in .d-bars i:nth-child(2){animation-delay:.1s} .cell--diff.is-in .d-bars i:nth-child(3){animation-delay:.2s}
    .cell--diff.is-in .d-bars i:nth-child(4){animation-delay:.3s} .cell--diff.is-in .d-bars i:nth-child(5){animation-delay:.15s}
    .cell--diff.is-in .d-bars i:nth-child(6){animation-delay:.25s} .cell--diff.is-in .d-bars i:nth-child(7){animation-delay:.05s}
    .cell--diff.is-in .d-bars i:nth-child(8){animation-delay:.35s} .cell--diff.is-in .d-bars i:nth-child(9){animation-delay:.2s}
  }
  @keyframes wave { 0%,100%{ height:22%; } 50%{ height:92%; } }
  .d-caption { color: var(--bone-soft); text-transform: none; letter-spacing: 0.05em; font-size: 11px; }

  @media (max-width: 620px) {
    .row--diff { grid-template-columns: 1fr; }
    .cell--diff:nth-child(even) { border-left: 0; }
    .cell--diff:nth-child(n+2) { border-top: 1px solid var(--line); }
    .demo { height: 78px; }
  }
<!-- STYLE_MARK -->
</style>
---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
---
<Base>
  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-in">
      <a href="/" class="nav-mark" aria-label="Angel0x1 — home"><Mark size={64} /></a>
      <nav class="nav-links">
        <a href="#vision" class="eyebrow">Vision</a>
        <a href="#waitlist" class="btn btn--ghost btn--sm">Join waitlist</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-eye" data-parallax="0.14" aria-hidden="true"><Mark size={300} /></div>
    <div class="wrap hero-copy center">
      <p class="eyebrow" data-reveal>A private journal · on-device AI</p>
      <h1 class="display" data-reveal>The journal<br/>that knows you.</h1>
      <p class="lede measure rd-1" data-reveal>
        Write, and it listens — building a quiet, accurate sense of who you are.
        Every word and every thought stays on your phone.
      </p>
      <div class="hero-actions rd-2" data-reveal>
        <a href="#waitlist" class="btn">Join the waitlist</a>
        <span class="eyebrow t-red">First 5,000 join free for life</span>
      </div>
    </div>
    <div class="hero-scroll eyebrow" aria-hidden="true">Scroll</div>
  </section>

  <!-- SOUL LINE -->
  <section class="section soulwrap center">
    <p class="soul h2" data-reveal>It knows you.<br/>It never tells.</p>
  </section>

  <!-- WHAT IT IS -->
  <section class="section" id="vision">
    <div class="wrap about center">
      <p class="eyebrow" data-reveal>What it is</p>
      <h2 class="h2 measure" data-reveal>An intelligence that lives in your pocket — and answers only to you.</h2>
      <div class="triad">
        <div class="tri" data-reveal>
          <span class="tri-k eyebrow">Reads</span>
          <p class="soft">It takes in what you write and reflects it back one honest layer deeper.</p>
        </div>
        <div class="tri rd-1" data-reveal>
          <span class="tri-k eyebrow">Remembers</span>
          <p class="soft">It keeps the thread of your moods, patterns, and the things you said matter.</p>
        </div>
        <div class="tri rd-2" data-reveal>
          <span class="tri-k eyebrow">Reflects</span>
          <p class="soft">No servers, no training on your pages. The model runs on your device alone.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- MARK_A -->

  <!-- PROGRESSION (no dates — a state of becoming, not a calendar) -->
  <section class="section prog">
    <div class="wrap">
      <p class="eyebrow center-block" data-reveal>Where it's going</p>
      <h2 class="h2 measure center-block" data-reveal>It begins as a journal.<br/>It becomes something that knows you.</h2>
    </div>
    <div class="wrap steps">
      <article class="step" data-reveal="soft">
        <span class="eyebrow step-k">Now</span>
        <div class="step-eye" aria-hidden="true">
          <svg viewBox="0 0 160 92" fill="none">
            <path d="M20,52 Q80,30 140,52" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
            <path d="M74,24 L80,14 M86,24 L92,15 M62,26 L66,17" stroke="var(--taupe)" stroke-width="2.4" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="h3">A journal.</h3>
        <p class="soft">You write. It reflects — naming the feeling underneath a half-step deeper than you did.</p>
      </article>

      <article class="step rd-1" data-reveal="soft">
        <span class="eyebrow step-k">Next</span>
        <div class="step-eye" aria-hidden="true">
          <svg viewBox="0 0 160 92" fill="none">
            <path d="M20,46 Q80,18 140,46 Q80,66 20,46 Z" fill="var(--ink)"/>
            <path d="M80,32 A14,14 0 0 0 80,60 Z" fill="var(--red)"/>
            <circle cx="80" cy="46" r="4.5" fill="var(--paper)"/>
          </svg>
        </div>
        <h3 class="h3">A companion.</h3>
        <p class="soft">It notices your patterns and reaches out — always citing a real memory, never a script.</p>
      </article>

      <article class="step rd-2" data-reveal="soft">
        <span class="eyebrow step-k">Someday</span>
        <div class="step-eye" aria-hidden="true">
          <svg viewBox="0 0 160 92" fill="none">
            <path d="M74,20 Q71,11 68,3 M80,19 L80,2 M86,20 Q89,11 92,3" stroke="var(--taupe)" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M20,46 Q80,10 140,46 Q80,82 20,46 Z" fill="var(--ink)"/>
            <path d="M80,26 A20,20 0 0 0 80,66 Z" fill="var(--red)"/>
            <circle cx="80" cy="46" r="6" fill="var(--paper)"/>
          </svg>
        </div>
        <h3 class="h3">An agent.</h3>
        <p class="soft">As on-device models grow, a mind that understands your life and can act on it — still yours, still silent.</p>
      </article>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="section privacy center">
    <div class="wrap center">
      <p class="soul h2 measure" data-reveal>All the intelligence.<br/>None of the surveillance.</p>
      <p class="lede measure rd-1" data-reveal>
        There is no account, no cloud, no company reading your pages. It is the only AI
        that will never sell what it knows about you — because it never had the chance.
      </p>
    </div>
  </section>

  <!-- WAITLIST -->
  <section class="section waitlist center" id="waitlist">
    <div class="waitlist-glow" aria-hidden="true"></div>
    <div class="wrap center">
      <div class="waitlist-mark" data-parallax="0.08" aria-hidden="true"><Mark size={128} /></div>
      <p class="eyebrow" data-reveal>Early access</p>
      <h2 class="h2 measure" data-reveal>Be there at the start.</h2>
      <p class="lede measure rd-1" data-reveal>
        Angel0x1 is in the making. The first 5,000 on the list get free lifetime
        access — every version, forever, no subscription.
      </p>
      <p class="eyebrow t-red rd-2" id="counter" data-reveal>Limited spots remaining</p>

      <form class="wl-form rd-2" id="waitlist-form" data-reveal novalidate>
        <input class="vh" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="wl-row">
          <label for="email" class="vh">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@email.com" autocomplete="email" required class="wl-input" />
          <button type="submit" class="btn" id="waitlist-submit"><span class="btn-label">Reserve my spot</span></button>
        </div>
        <p class="wl-msg eyebrow" id="form-msg" aria-live="polite"></p>
        <p class="wl-note eyebrow faint">Only used to reach you at launch. No newsletters, no sharing.</p>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap foot-in">
      <a href="/" aria-label="Angel0x1"><Mark size={48} /></a>
      <p class="eyebrow faint">Angel0x1 · all AI, on your device</p>
      <nav class="foot-links">
        <a href="/privacy" class="eyebrow">Privacy</a>
        <a href="/terms" class="eyebrow">Terms</a>
      </nav>
    </div>
  </footer>

  <script type="module" src="/scripts/waitlist.js"></script>
  <!-- MARK_B -->
</Base>

<style>
  /* NAV */
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 90;
    background: rgba(252,251,249,0.72); backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line-2); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; padding-block: 8px; }
  .nav-links { display: flex; align-items: center; gap: 24px; }
  .nav-links a.eyebrow:hover { color: var(--ink); }
  .btn--sm { padding: 9px 18px; font-size: 13px; }

  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    padding: clamp(120px,20vh,200px) var(--gutter) 90px; overflow: hidden; }
  .hero-glow { position: absolute; width: min(120vw,1100px); aspect-ratio: 1; top: 34%;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(179,58,43,0.10) 0%, rgba(179,58,43,0.04) 34%, transparent 62%);
    pointer-events: none; }
  .hero-eye { margin-bottom: clamp(18px,4vh,44px); filter: drop-shadow(0 24px 44px rgba(26,23,20,0.13)); }
  .hero-copy { gap: 26px; position: relative; }
  .hero-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .hero-scroll { position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    color: var(--faint); font-size: 10px; animation: bob 2.4s var(--ease) infinite; }
  @keyframes bob { 0%,100%{transform:translate(-50%,0)} 50%{transform:translate(-50%,6px)} }
  @media (prefers-reduced-motion: reduce){ .hero-scroll{animation:none} }

  /* SOUL */
  .soulwrap { padding-block: clamp(120px,22vh,260px); }
  .soul { color: var(--ink); }

  /* ABOUT */
  .about { gap: 22px; }
  .center-block { margin-inline: auto; text-align: center; }
  .about .h2 { margin-inline: auto; }
  .triad { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(28px,4vw,64px);
    margin-top: clamp(44px,7vh,90px); text-align: left; width: 100%; }
  .tri { display: flex; flex-direction: column; gap: 12px; }
  .tri-k { color: var(--red); }
  .tri p { max-width: 34ch; }
  @media (max-width: 760px){ .triad{ grid-template-columns:1fr; gap:34px; max-width:34ch; margin-inline:auto; } }
  /* MARK_C */

  /* PROGRESSION */
  .prog { background: var(--panel); border-block: 1px solid var(--line-2); }
  .prog .h2 { margin-top: 12px; }
  .steps { display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(30px,4vw,72px);
    margin-top: clamp(56px,8vh,110px); }
  .step { display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
    padding-top: 26px; border-top: 1px solid var(--line); }
  .step-k { color: var(--faint); }
  .step-eye { width: 100%; max-width: 150px; margin: 6px 0 4px; }
  .step-eye svg { width: 100%; height: auto; overflow: visible; }
  .step h3 { letter-spacing: -0.03em; }
  .step p { color: var(--soft); }
  @media (max-width: 760px){ .steps{ grid-template-columns:1fr; gap:0; }
    .step{ padding-block:34px; } .step-eye{ max-width:130px; } }

  /* PRIVACY */
  .privacy { gap: 26px; }
  .privacy .soul { color: var(--ink); margin-inline: auto; }
  .privacy .lede { margin-inline: auto; margin-top: 6px; }

  /* WAITLIST */
  .waitlist { position: relative; overflow: hidden; gap: 22px; }
  .waitlist-glow { position: absolute; inset: 0;
    background: radial-gradient(ellipse 55% 60% at 50% 30%, rgba(179,58,43,0.08) 0%, transparent 70%);
    pointer-events: none; }
  .waitlist-mark { margin-bottom: 10px; filter: drop-shadow(0 16px 30px rgba(26,23,20,0.12)); }
  .waitlist .h2, .waitlist .lede { margin-inline: auto; }
  .wl-form { width: 100%; max-width: 520px; margin: 22px auto 0; display: flex; flex-direction: column; gap: 14px; }
  .wl-row { display: flex; gap: 10px; }
  .wl-input { flex: 1; min-width: 0; font-family: var(--sans); font-size: 16px;
    background: var(--panel); border: 1px solid var(--line); color: var(--ink);
    border-radius: 980px; padding: 15px 22px; transition: border-color 0.25s, box-shadow 0.25s; }
  .wl-input::placeholder { color: var(--faint); }
  .wl-input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgba(26,23,20,0.05); }
  .wl-input.error { border-color: var(--red); }
  .wl-msg { min-height: 16px; letter-spacing: 0.16em; }
  .wl-msg.ok { color: var(--red); } .wl-msg.err { color: #c0392b; }
  .wl-note { margin-top: 2px; }
  @media (max-width: 560px){ .wl-row{ flex-direction: column; } .wl-input,.wl-row .btn{ width:100%; justify-content:center; } }

  /* FOOTER */
  .foot { border-top: 1px solid var(--line-2); padding: 46px var(--gutter) 60px; }
  .foot-in { max-width: 1200px; margin-inline: auto; display: flex; align-items: center;
    justify-content: space-between; flex-wrap: wrap; gap: 20px; }
  .foot-links { display: flex; gap: 22px; }
  .foot-links a.eyebrow:hover { color: var(--ink); }
</style>



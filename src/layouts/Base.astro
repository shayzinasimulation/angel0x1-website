---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  og?: string;
}
const {
  title = 'Angel0x1 — The journal that knows you.',
  description = 'A private, on-device AI journal that builds a picture of who you are — and never tells anyone. Reserve your spot: the first 1,000 get 3 months free.',
  og = '/og.png',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/gif" href="/favicon.gif" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <!-- global.css is imported in the frontmatter so Astro emits it as an external,
         hashed same-origin stylesheet (CSP style-src 'self'); no external fonts or
         trackers. -->
  </head>
  <body>
    <div class="scrollbar" aria-hidden="true"></div>
    <slot />
    <!-- Lenis (self-hosted, CSP script-src 'self') loads first; reveal.js drives its
         rAF loop. menu.js toggles the mobile overlay. `is:inline` keeps Astro from
         bundling these public/ assets — they stay external same-origin files (no inline
         JS is emitted), so the strict CSP holds. -->
    <script is:inline src="/scripts/lenis.min.js"></script>
    <script is:inline type="module" src="/scripts/reveal.js"></script>
    <script is:inline type="module" src="/scripts/menu.js"></script>
  </body>
</html>

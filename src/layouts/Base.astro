---
import '../styles/global.css';
import { SITE, activeSocials } from '../config/site.ts';
interface Props {
  title?: string;
  description?: string;
  og?: string;
  bodyClass?: string;
}
const {
  title = 'Angel0x1 — the journal that reads you forward',
  description = 'A private, on-device AI journal that reads your past entries and shows where you’re heading — recurring words, patterns, a projected trajectory. On-device model hub + voice input. Nothing ever leaves your phone. First 1,000 reserve 3 months free.',
  og = '/og.png',
  bodyClass = '',
} = Astro.props;

// Absolute URLs (link unfurlers + canonical require them). Astro.site = angel0x1.fun.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(og, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.domain}/#org`,
      name: SITE.name,
      url: SITE.domain,
      logo: ogImage,
      sameAs: activeSocials().map((s) => s.href),
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.domain}/#site`,
      name: SITE.name,
      url: SITE.domain,
      publisher: { '@id': `${SITE.domain}/#org` },
    },
    {
      // What the product IS — helps search + AI answer engines describe it accurately.
      // Honest + pre-launch: no invented ratings, price, or store URL.
      '@type': 'SoftwareApplication',
      '@id': `${SITE.domain}/#app`,
      name: SITE.name,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'iOS',
      url: SITE.domain,
      publisher: { '@id': `${SITE.domain}/#org` },
      description:
        'A private journaling app that runs entirely on your device. It reads your own past entries with on-device AI (retrieval over your encrypted journal) to surface recurring words, reflections, and a projected trajectory of where you’re heading. Includes a local model hub and on-device voice input. Entries are encrypted with AES-256-GCM and never leave the phone.',
      featureList: [
        'Predictive reading of your own past journal entries (on-device RAG)',
        'Finds recurring words, themes, and reflections across months',
        'Local model hub — choose from multiple on-device models',
        'On-device voice input, transcribed locally',
        'AES-256-GCM encryption; nothing is sent to any server',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'First 1,000 who reserve get 3 months free at launch' },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#F4F1EA" />

    <!-- Open Graph (absolute URLs; 1200×630 card) -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Angel0x1 — the journal that reads you forward." />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@angel0x1_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/gif" href="/favicon.gif" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- global.css is imported in the frontmatter so Astro emits it as an external,
         hashed same-origin stylesheet (CSP style-src 'self'); no external fonts or
         trackers. -->
  </head>
  <body class={bodyClass}>
    <div class="scrollbar" aria-hidden="true"></div>
    <slot />
    <!-- Lenis (self-hosted, CSP script-src 'self') gives the slow, held-breath scroll;
         reveal.js drives its rAF loop + scroll-reveals. `is:inline` keeps Astro from
         bundling these public/ assets — external same-origin files, no inline JS, CSP holds. -->
    <script is:inline src="/scripts/lenis.min.js"></script>
    <script is:inline type="module" src="/scripts/reveal.js"></script>
    <script is:inline type="module" src="/scripts/eye.js"></script>
  </body>
</html>

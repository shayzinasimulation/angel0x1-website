# ─────────────────────────────────────────────────────────────────────────────
# Angel0x1 web — environment template.  COPY to `.env` (gitignored) for local dev,
# and set the SAME keys in your host's dashboard (Vercel → Project → Settings →
# Environment Variables) for production.  NEVER put real secrets in this file, in
# client code, or anywhere under src/ that ships to the browser.
#
# Everything here is read ONLY on the server (src/lib/*, src/pages/api/*) via
# process.env — never import.meta.env.  The site runs with NO values set: the store
# falls back to in-memory and email falls back to returning the code in the API
# response (dev only), so you can preview the whole flow before creating any account.
#
# NOTE: public things (social links, the 1,000 cap shown in copy) live in
# src/config/site.ts — NOT here.  This file is for secrets + server config only.
# ─────────────────────────────────────────────────────────────────────────────

# ── storage ──────────────────────────────────────────────────────────────────
# "none" = in-memory (dev only, resets on restart).  "supabase" = persist to Postgres.
WAITLIST_STORE="none"

# Supabase (only when WAITLIST_STORE="supabase").  Use the SERVICE ROLE key —
# server-only, bypasses Row Level Security.  Never expose it to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Total number of free spots.  Keep in sync with src/config/site.ts `cap`.
WAITLIST_CAP="1000"

# ── abuse / crypto (server-only secrets) ─────────────────────────────────────
# Random 32+ byte hex strings.  Generate each with:  openssl rand -hex 32
# IP_HASH_SALT salts the one-way hash of visitor IPs (we never store raw IPs).
# OTP_SALT salts the one-way hash of the 6-digit codes (we never store raw codes).
IP_HASH_SALT=""
OTP_SALT=""

# Max verified reservations allowed per hashed IP (fair-use / anti-farming).
IP_CLAIM_CAP="3"

# One-time code lifetime (minutes) and max verify attempts before it's invalidated.
OTP_TTL_MIN="10"
OTP_MAX_ATTEMPTS="5"

# ── email (Resend) ───────────────────────────────────────────────────────────
# "none" = don't send; the code is returned in the API response for local testing.
# "resend" = send real OTP + confirmation emails.
EMAIL_PROVIDER="none"

# Resend API key (server-only).  Free tier: 100 emails/day, 3,000/month, 1 domain.
RESEND_API_KEY=""

# The From address.  Before you verify a domain you can send to your OWN inbox from
# the shared sender below.  After verifying angel0x1.com, switch to hello@angel0x1.com.
RESEND_FROM="Angel0x1 <onboarding@resend.dev>"
